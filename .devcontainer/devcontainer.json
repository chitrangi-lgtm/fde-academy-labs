{
  // FDE Academy labs in GitHub Codespaces (or VS Code Dev Containers): a real Linux machine in the browser with Docker,
  // Kubernetes (kind), Terraform, the cloud CLIs and every lab's Python libraries installed. Free on each learner's own
  // GitHub allowance (120 core hours a month on GitHub Free: about 60 hours on this 2-core machine). Stop the codespace
  // when you finish; GitHub stops idle ones after 30 minutes. With no payment method on the account it can never bill you.
  "name": "FDE Academy labs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": { "DEEPEVAL_TELEMETRY_OPT_OUT": "YES", "PYTHONDONTWRITEBYTECODE": "1" },
  "forwardPorts": [16686, 6333, 5000],
  "portsAttributes": {
    "16686": { "label": "Jaeger tracing UI" },
    "6333": { "label": "Qdrant" },
    "5000": { "label": "Moto (local AWS)", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["START_HERE.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "hashicorp.terraform", "ms-azuretools.vscode-docker",
                     "ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  }
}
