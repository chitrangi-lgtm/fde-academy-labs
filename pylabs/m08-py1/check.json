 "setup": "import numpy as _np\nQ = _np.array([[1.0, 0.0], [0.0, 1.0], [1.0, 1.0], [0.5, -0.5]])\nK = _np.array([[1.0, 0.5], [0.0, 1.0], [1.0, -1.0], [0.5, 0.5]])\nV = _np.array([[1.0, 0.0], [0.0, 2.0], [3.0, 1.0], [0.5, 0.5]])\n# Expected values for these Q, K and V, computed once and written out.\n_OUT = _np.array([[1.36173521824, 0.731469015633], [0.673328488117, 0.979874267031],\n                  [0.868818485317, 0.764086102661], [1.579657569476, 0.798691531282]])\n_W_CAUSAL = _np.array([[1.0, 0.0, 0.0, 0.0], [0.41252099916, 0.58747900084, 0.0, 0.0],\n                       [0.488182167425, 0.342795904518, 0.169021928057, 0.0],\n                       [0.24237307721, 0.14261491482, 0.411911395312, 0.203100612657]])\n",
 "setup_first": true,
 "checks": [
  [
   "The output matches scaled dot-product attention",
   "_np.allclose(attention(Q, K, V)[0], _OUT)"
  ],
  [
   "The causal weights match",
   "_np.allclose(attention(Q, K, V, causal=True)[1], _W_CAUSAL)"
  ],
  [
   "Each row of weights sums to 1",
   "_np.allclose(attention(Q, K, V, causal=True)[1].sum(axis=1), 1)"
  ],
  [
   "Token 1 cannot attend to token 2 under the mask",
   "abs(attention(Q, K, V, causal=True)[1][0, 1]) < 1e-12"
  ],
  [
   "Large scores do not overflow (no NaN)",
   "not _np.isnan(attention(Q * 1000, K, V)[1]).any()"
  ],
  [
   "A heatmap is drawn",
   "'matplotlib.pyplot' in _sys.modules and len(_sys.modules['matplotlib.pyplot'].get_fignums()) >= 1"
  ]
 ]
}